# Versions that scripts/preflight.sh asserts. Keep them equal to the pins in mise.toml.
COLIMA_VERSION=0.10.3
KIND_VERSION=0.33.0
DOCKER_CLI_VERSION=29.9.3
KUBECTL_VERSION=1.37.2
COLIMA_PROFILE=poc
COLIMA_RUNTIME=docker
# Time budgets of the gates in whole minutes. scripts/gate.sh fails a run that takes longer.
GATE_M1_BUDGET_MINUTES=3
GATE_M2_BUDGET_MINUTES=14
# The cleanup of the key rotation test of gate:m2 runs scripts/gate-m2-repair.sh, which is bounded at 41 minutes in repairAPIServer (test/e2e/keyrotation_test.go). The go test
# timeout of gate:m2 is 60 minutes: that bound, plus the 5 minutes of the key rotation test before the cleanup and the 8 minutes of the other M2 tests, is 54 minutes.
GATE_M2_TEST_TIMEOUT_MINUTES=60
GATE_M3_BUDGET_MINUTES=66
GATE_M4_BUDGET_MINUTES=40
# gate:m4:rotate measured 9 minutes. The go test timeout is twice this budget, 50 minutes, which is above rotateWait (45 minutes) in test/e2e/m4_rotate_test.go.
GATE_M4_ROTATE_BUDGET_MINUTES=25
# gate:m5:soak runs for 30 minutes on its own, so the budget adds 10 minutes for the checks and the cleanup. The go test timeout is twice this budget.
GATE_M5_SOAK_BUDGET_MINUTES=40
# gate:m5 runs every TestM5 test. The slowest M5 run before the fixes took 3096 s of tests on 2026-11-15 (UTC), and the budget is 1.5 times that, rounded up to 5 minutes. The go test timeout is twice this budget.
GATE_M5_BUDGET_MINUTES=80
# gate:m6:provision budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 1327.5 s (2026-11-17, bb28caa)
# and 1431.4 s (2026-11-17, 4a5453e); 1431.4 s is 23.9 minutes, 1.5 times that is 35.8, and the budget is 40 minutes. The test bounds each
# wait, and the sum of all bounds is the worst case: 2 (start, both cells
# valid) + 5 (withdraw) + 30 (two cell:down at 15) + 20 (two cell:verify at 10) + 10 (the refused cell:up) + 1 (host spec) + 2 (step-status)
# + 6 (step 6: two cases at 2 for the item and 1 for the refusal) + 75 (both steps done) + 12 (step 8: two cells at 2 for the SVID, 2 for the
# stream and 2 for bound) + 9 (step 9: 5 for valid and two operations at 2) + 2 (step 10) = 174 minutes. The floor of the go test timeout is 175,
# the worst case rounded up to 5 minutes. The timeout is the larger of twice the budget (80 now) and this floor, so the Go timeout never
# ends a run that stays inside its bounds, and the budget check fails a run that takes longer than 40 minutes.
GATE_M6_PROVISION_BUDGET_MINUTES=40
GATE_M6_PROVISION_TEST_TIMEOUT_MINUTES=175
# gate:m6 budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 947.8 s (2026-11-17, e1997fd) and 964 s
# (2026-11-17, 4a5453e); 964 s is 16.1 minutes, 1.5 times that is 24.1, and the budget is 25 minutes. The go test timeout is twice the budget, 50 minutes.
GATE_M6_BUDGET_MINUTES=25
# gate:m7 has no budget yet. The live part of M7 sets GATE_M7_BUDGET_MINUTES to 1.5 times the slower of two clean runs, rounded up to 5 minutes: <set in the live part>.
# It then sets GATE_M7_TEST_TIMEOUT_MINUTES to twice that budget. While the value is empty, gate.sh runs no budget check.
GATE_M7_BUDGET_MINUTES=
