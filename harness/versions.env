# Versions that scripts/preflight.sh asserts. Keep them equal to the pins in mise.toml.
COLIMA_VERSION=0.10.3
KIND_VERSION=0.33.0
DOCKER_CLI_VERSION=29.9.3
KUBECTL_VERSION=1.37.2
COLIMA_PROFILE=poc
COLIMA_RUNTIME=docker
# Time budgets of the gates in whole minutes. scripts/gate.sh fails a run that takes longer.
GATE_M1_BUDGET_MINUTES=3
GATE_M2_BUDGET_MINUTES=14
# The cleanup of the key rotation test of gate:m2 runs scripts/gate-m2-repair.sh, which is bounded at 41 minutes in repairAPIServer (test/e2e/keyrotation_test.go). The go test
# timeout of gate:m2 is 60 minutes: that bound, plus the 5 minutes of the key rotation test before the cleanup and the 8 minutes of the other M2 tests, is 54 minutes.
GATE_M2_TEST_TIMEOUT_MINUTES=60
# gate:m3 budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 4428 s and 4343 s (2026-11-24, 3185c1b);
# 4428 s is 73.8 minutes, 1.5 times that is 110.7, and the budget is 115 minutes. The go test timeout is twice the budget, 230 minutes.
GATE_M3_BUDGET_MINUTES=115
GATE_M4_BUDGET_MINUTES=40
# gate:m4:rotate measured 9 minutes. The go test timeout is twice this budget, 50 minutes, which is above rotateWait (45 minutes) in test/e2e/m4_rotate_test.go.
GATE_M4_ROTATE_BUDGET_MINUTES=25
# gate:m5:soak runs for 30 minutes on its own, so the budget adds 10 minutes for the checks and the cleanup. The go test timeout is twice this budget.
GATE_M5_SOAK_BUDGET_MINUTES=40
# gate:m5 runs every TestM5 test. The slowest M5 run before the fixes took 3096 s of tests on 2026-11-15 (UTC), and the budget is 1.5 times that, rounded up to 5 minutes. The go test timeout is twice this budget.
GATE_M5_BUDGET_MINUTES=80
# gate:m5:drill has no budget, so its go test timeout is this value. The bounds of TestGatewayVolumeLostDrill sum to 62.5 minutes:
# 2 (queue) + 5 (applied) + 2 (outbox) + 12 (gw:reset) + 5 (reported) + 26.5 (status loop: 10.5 minutes of retries, then one attempt of 16)
# + 10 (ready checks). A Go timeout skips the cleanup, so the value stays above that sum.
GATE_M5_DRILL_TEST_TIMEOUT_MINUTES=65
# gate:m6:provision budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 3276 s and 3046 s (2026-11-24,
# 3185c1b); 3276 s is 54.6 minutes, 1.5 times that is 81.9, and the budget is 85 minutes. The test bounds each
# wait, and the sum of all bounds is the worst case: 2 (start, both cells
# valid) + 5 (withdraw) + 30 (two cell:down at 15) + 20 (two cell:verify at 10) + 10 (the refused cell:up) + 1 (host spec) + 2 (step-status)
# + 6 (step 6: two cases at 2 for the item and 1 for the refusal) + 75 (both steps done) + 12 (step 8: two cells at 2 for the SVID, 2 for the
# stream and 2 for bound) + 9 (step 9: 5 for valid and two operations at 2) + 37 (step 10: 2 for the live spec, 15 for the signed publish and two cell:verify at 10) = 209 minutes. The floor of the go test timeout is 210,
# the worst case rounded up to 5 minutes. The timeout is the larger of twice the budget (170 now) and this floor, so the Go timeout never
# ends a run that stays inside its bounds, and the budget check fails a run that takes longer than 85 minutes.
GATE_M6_PROVISION_BUDGET_MINUTES=85
GATE_M6_PROVISION_TEST_TIMEOUT_MINUTES=210
# gate:m6 budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 1549 s and 1583 s (2026-11-24, dae059b);
# 1583 s is 26.4 minutes, 1.5 times that is 39.6, and the budget is 40 minutes. The go test timeout is twice the budget, 80 minutes.
GATE_M6_BUDGET_MINUTES=40
# gate:m7 budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 731 s and 737 s (2026-11-18, 881a9bc and the test fixes
# of a4c167b); 737 s is 12.3 minutes, 1.5 times that is 18.4, and the budget is 20 minutes. The go test timeout is twice the budget, 40 minutes.
GATE_M7_BUDGET_MINUTES=20
# A timeout panic skips every cleanup of a test, so the value must not end a run that stays inside its waits. The slowest test, TestM7InterceptCellProxyHops, takes about 5.4 minutes.
GATE_M7_TEST_TIMEOUT_MINUTES=40
# gate:m8 budget: 1.5 times the slower of two clean runs, rounded up to 5 minutes. The runs were 3993 s and 4007 s (2026-11-19, 18879dd);
# 4007 s is 66.8 minutes, 1.5 times that is 100.2, and the budget is 105 minutes. The go test timeout is twice the budget, 210 minutes.
GATE_M8_BUDGET_MINUTES=105
GATE_M8_TEST_TIMEOUT_MINUTES=210
# gate:m9 runs the slow tier with this SVID lifetime in dev-cp. A caller value of GATE_M9_SVID_TTL wins, and the run is then not a record.
GATE_M9_SVID_TTL=1h
# gate:m9 budget: it covers the whole tier, from the switch of the lifetime to the restore. It is 1.5 times the slower of two clean runs, rounded
# up to 5 minutes. The runs were 17105 s and 16198 s (2026-11-24, 3185c1b); 17105 s is 285.1 minutes, 1.5 times that is 427.6, and the budget is 430 minutes.
GATE_M9_BUDGET_MINUTES=430
# The -timeout of each go test invocation of gate:m9, as it stands. A Go timeout skips every cleanup, so it stays above the largest bound of
# one test, 255 minutes for TestM9IslandsHold, rounded up to 5 minutes, with margin. TestM9IslandsHold took 199 minutes in the slower run.
GATE_M9_TEST_TIMEOUT_MINUTES=270
# gate:m15 budget: the budget covers only the go test run. It is 1.5 times the slower of two clean runs, rounded up to 5 minutes. The go test runs were
# 1328 s and 1230 s (2026-11-26, a61bdf2); 1328 s is 22.1 minutes, 1.5 times that is 33.2, and the budget is 35 minutes.
# The go test timeout is twice the budget, 70 minutes, above the 41-minute bound of repairAPIServer plus the other tests.
GATE_M15_BUDGET_MINUTES=35
GATE_M15_TEST_TIMEOUT_MINUTES=70
# poc:gate -- fast budget in minutes. Empty: no bound.
GATE_FAST_BUDGET_MINUTES=
