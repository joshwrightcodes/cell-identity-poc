# Versions that scripts/preflight.sh asserts. Keep them equal to the pins in mise.toml.
COLIMA_VERSION=0.10.3
KIND_VERSION=0.33.0
DOCKER_CLI_VERSION=29.9.3
KUBECTL_VERSION=1.37.2
COLIMA_PROFILE=poc
COLIMA_RUNTIME=docker
# Time budgets of the gates in whole minutes. scripts/gate.sh fails a run that takes longer.
GATE_M1_BUDGET_MINUTES=3
GATE_M2_BUDGET_MINUTES=14
# The cleanup of the key rotation test of gate:m2 runs scripts/gate-m2-repair.sh, which is bounded at 41 minutes in repairAPIServer (test/e2e/keyrotation_test.go). The go test
# timeout of gate:m2 is 60 minutes: that bound, plus the 5 minutes of the key rotation test before the cleanup and the 8 minutes of the other M2 tests, is 54 minutes.
GATE_M2_TEST_TIMEOUT_MINUTES=60
GATE_M3_BUDGET_MINUTES=66
GATE_M4_BUDGET_MINUTES=40
# gate:m4:rotate measured 9 minutes. The go test timeout is twice this budget, 50 minutes, which is above rotateWait (45 minutes) in test/e2e/m4_rotate_test.go.
GATE_M4_ROTATE_BUDGET_MINUTES=25
# gate:m5:soak runs for 30 minutes on its own, so the budget adds 10 minutes for the checks and the cleanup. The go test timeout is twice this budget.
GATE_M5_SOAK_BUDGET_MINUTES=40
# gate:m5 runs every TestM5 test. The slowest M5 run before the fixes took 3096 s of tests on 2026-11-15 (UTC), and the budget is 1.5 times that, rounded up to 5 minutes. The go test timeout is twice this budget.
GATE_M5_BUDGET_MINUTES=80
