# Versions that scripts/preflight.sh asserts. Keep them equal to the pins in mise.toml.
COLIMA_VERSION=0.10.3
KIND_VERSION=0.33.0
DOCKER_CLI_VERSION=29.9.3
KUBECTL_VERSION=1.37.2
COLIMA_PROFILE=poc
