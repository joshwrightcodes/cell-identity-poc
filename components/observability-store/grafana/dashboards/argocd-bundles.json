{
  "uid": "poc-argocd-bundles",
  "title": "Argo CD and bundle sets",
  "tags": [
    "cell-identity-poc"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{k8s_cluster_name=~\".+\"}, k8s_cluster_name)",
        "definition": "label_values(up{k8s_cluster_name=~\".+\"}, k8s_cluster_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Applications synced",
      "description": "Argo CD applications in sync, of all applications. Reads argocd_app_info.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", sync_status=\"Synced\", service_name!=\"m15-synthetic\"}) or 0 * count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"})",
          "instant": true,
          "legendFormat": "synced"
        },
        {
          "refId": "B",
          "expr": "count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"})",
          "instant": true,
          "legendFormat": "of"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e7f96",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Applications healthy",
      "description": "Argo CD applications that are healthy, of all applications. Reads argocd_app_info.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", health_status=\"Healthy\", service_name!=\"m15-synthetic\"}) or 0 * count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"})",
          "instant": true,
          "legendFormat": "healthy"
        },
        {
          "refId": "B",
          "expr": "count(argocd_app_info{job=\"argocd\", k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"})",
          "instant": true,
          "legendFormat": "of"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6e7f96",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rollbacks 7 days",
      "description": "Bundle sets that the appliers rolled back in the last 7 days. Reads bundle_apply_outcomes_total.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(((bundle_apply_outcomes_total{k8s_cluster_name=~\"$cluster\", outcome=\"rolled_back\", service_name!=\"m15-synthetic\"} unless bundle_apply_outcomes_total{k8s_cluster_name=~\"$cluster\", outcome=\"rolled_back\", service_name!=\"m15-synthetic\"} offset 7d) or increase(bundle_apply_outcomes_total{k8s_cluster_name=~\"$cluster\", outcome=\"rolled_back\", service_name!=\"m15-synthetic\"}[7d])))) or vector(0)",
          "instant": true,
          "eventOnly": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Store denials",
      "description": "Requests that the bundle store proxy refused in the time range. Reads store_proxy_denials_total.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(((store_proxy_denials_total{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"} unless store_proxy_denials_total{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"} offset $__range) or increase(store_proxy_denials_total{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[$__range])))) or vector(0)",
          "instant": true,
          "eventOnly": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Signed sets by target",
      "description": "The signed set of each applier, sorted by the numeric Applied time. Version 0.0 is the bootstrap state. Reads bundle_set_applied_seconds, bundle_sync_delay_seconds_sum, bundle_sync_delay_seconds_count.",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (k8s_cluster_name, role, version, root_digest, state) (last_over_time(bundle_set_applied_seconds{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[2m]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (k8s_cluster_name) (increase(bundle_sync_delay_seconds_sum{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[$__range])) / sum by (k8s_cluster_name) (increase(bundle_sync_delay_seconds_count{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "#6e7f96",
                  "index": 99,
                  "text": "n/a"
                }
              },
              "type": "special"
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0.0": {
                        "color": "#6e7f96",
                        "index": 0,
                        "text": "bootstrap"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#6e7f96",
                        "index": 99,
                        "text": "n/a"
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Set"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0.0": {
                        "color": "#6e7f96",
                        "index": 0,
                        "text": "bootstrap"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#6e7f96",
                        "index": 99,
                        "text": "n/a"
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Root digest"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0.0": {
                        "color": "#6e7f96",
                        "index": 0,
                        "text": "bootstrap"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#6e7f96",
                        "index": 99,
                        "text": "n/a"
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0.0": {
                        "color": "#6e7f96",
                        "index": 0,
                        "text": "bootstrap"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#6e7f96",
                        "index": 99,
                        "text": "n/a"
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Applied"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Apply time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Applied"
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "k8s_cluster_name",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Value #A",
                "Value #B",
                "k8s_cluster_name",
                "root_digest",
                "state",
                "version"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Value #A": 3,
              "Value #B": 4,
              "k8s_cluster_name": 0,
              "root_digest": 2,
              "state": 5,
              "version": 1
            },
            "renameByName": {
              "Value #A": "Applied",
              "Value #B": "Apply time",
              "k8s_cluster_name": "Target",
              "role": "Role",
              "root_digest": "Root digest",
              "state": "Result",
              "version": "Set"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Sync time after a tag move",
      "description": "Median time from a tag move of deploy to the end of the health wait. Reads bundle_sync_delay_seconds_bucket.",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.5, sum by (k8s_cluster_name, le) (increase(bundle_sync_delay_seconds_bucket{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[$__range])))) or on() vector(0)",
          "instant": true,
          "legendFormat": "{{k8s_cluster_name}}",
          "eventOnly": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cell-1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cell-2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#d95926",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#199e70",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sync operations per hour",
      "description": "Argo CD sync operations in each hour. Reads argocd_app_sync_total.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_cluster_name) (increase(argocd_app_sync_total{k8s_cluster_name=~\"$cluster\", service_name!=\"m15-synthetic\"}[1h]))",
          "range": true,
          "legendFormat": "{{k8s_cluster_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cell-1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cell-2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#d95926",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dev-cp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#199e70",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
