# Settings for the local cell. These values are not secret.
CELL_NAME=cell-a-1
CELL_CPUS=6
CELL_MEMORY=12g
# The node image that kind v0.33.0 uses by default, pinned by digest.
CELL_NODE_IMAGE=docker.io/kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# The mesh trust domain belongs to this cluster only. Nothing outside the cluster trusts it.
CELL_MESH_TRUST_DOMAIN=cell-a-1.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_STORE_LOCAL_PORT=5050
ARGOCD_VERSION=v3.6.1
ISTIO_VERSION=1.30.8
