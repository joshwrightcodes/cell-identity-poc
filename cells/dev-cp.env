# Settings for the dev-cp cluster. These values are not secret.
CELL_NAME=dev-cp
CELL_MESH_TRUST_DOMAIN=dev-cp.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_BUNDLE_STORE_PORT=5051
# The trust domain of the SPIRE server in this cluster: the environment trust domain.
SPIRE_TRUST_DOMAIN=dev.env.poc.internal
# The intermediate CA from the secret manager signs the CA of the server.
SPIRE_UPSTREAM=disk
# Cells whose SPIRE agents attest to the server in this cluster with cluster_jwt.
SPIRE_AGENT_CELLS="dev-cell-1 dev-cell-2"
# The ServiceAccount of each agent pod in a cell, as <namespace>/<service account>=<role>. The role
# names the workload ID spiffe://dev.env.poc.internal/cell/<cell>/<role>, under the node alias
# spiffe://dev.env.poc.internal/cell/<cell>/agents/<role>. Each cell record lists every subject.
SPIRE_CELL_SUBJECTS="cell-identity-system/celld=celld argocd/argocd-agent=argocd-agent observability-system/otel-uplink=otel mesh-view-system/mesh-view=mesh-view"
# Plane workloads of this cluster, as <spiffe path>=<namespace>/<service account>. Each attests with
# a k8s_psat agent sidecar.
SPIRE_LOCAL_WORKLOADS="cp/otel=observability-system/otel-uplink"
# The relay in relay-system passes the streams of the cells to the node of RELAY_TARGET, by port.
# Each route is <node port>:<container port>=<node port of RELAY_TARGET>. Deployment relay-view
# carries the view and the mesh view, and relay-telemetry carries the telemetry. Only the node
# addresses of SPIRE_AGENT_CELLS reach the node ports.
RELAY_TARGET=management
RELAY_VIEW_ROUTES="30443:8443=31443 30445:8445=31445"
RELAY_TELEMETRY_ROUTES="30444:8444=31444"
# The store namespace of the External Secrets Operator. secrets:connect applies SecretStore
# poc-secrets there, and the operator works only there. It takes exactly one namespace.
SECRET_STORE_NAMESPACES=spire-system
# Lifetime of agent and workload SVIDs. 1m lets a gate see two renewals in about a minute. Set 1h
# for an environment that stays up without gates. The render accepts 1m to ca_ttl / 6 (4h).
SPIRE_SVID_TTL=1m
# The collector of dev-cp sets the plane environment and the environment name, and exports through
# the uplink to the gateway in management. COLLECTOR_SENDERS names the namespaces that send OTLP to
# the collector on 4317 (flow N11). COLLECTOR_JOBS names the scrape jobs that this cluster adds to
# envoy, istiod and argocd.
COLLECTOR_PLANE=environment
COLLECTOR_SENDERS="apps-demo argocd istio-egress relay-system"
COLLECTOR_JOBS="spire-server"
