# Settings for the dev-cp cluster. These values are not secret.
CELL_NAME=dev-cp
CELL_MESH_TRUST_DOMAIN=dev-cp.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_BUNDLE_STORE_PORT=5051
# Cells whose SPIRE agents attest to the server in this cluster. The agent runs as a sidecar in
# the celld pod, so the attested ServiceAccount is the celld one in each cell.
SPIRE_AGENT_CELLS="dev-cell-1 dev-cell-2"
SPIRE_AGENT_SUBJECT=cell-identity-system/celld
# Namespaces that may read from the ClusterSecretStore that secrets:connect applies.
SECRET_STORE_NAMESPACES=spire-system
