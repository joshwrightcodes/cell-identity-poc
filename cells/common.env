# Settings shared by every cell. These values are not secret.
# The name of the environment. The cluster_jwt plugins and the cell records carry it, and each
# attestation token has the audience spire-<POC_ENV>/<nonce>.
POC_ENV=dev
# Upstream versions.
ARGOCD_VERSION=v3.6.1
# The Argo CD Agent. ARGOCD_AGENT_MANIFESTS_SHA256 is the SHA-256 of its reviewed principal and agent
# manifests, over the sorted file list as scripts/vendor-fetch.sh computes it. ARGOCD_AGENT_IMAGE
# pins the index digest from the review in vendor/README.md.
ARGOCD_AGENT_VERSION=v0.10.0
ARGOCD_AGENT_MANIFESTS_SHA256=c0cda6f7fbed368c4b3f7dd085095df47f79436cd4894d22a6cfa9eb0d647c56
ARGOCD_AGENT_IMAGE=quay.io/argoprojlabs/argocd-agent:v0.10.0@sha256:ec9baba6e81555bfa5ce1fa6252f06c6100b56ae7f85273ba2f7e2309303800d
ISTIO_VERSION=1.30.8
# The External Secrets Operator chart, and the SHA-256 of its archive from the review in vendor/README.md.
EXTERNAL_SECRETS_VERSION=2.14.0
EXTERNAL_SECRETS_CHART_SHA256=0a6d9e91b1ff50adfdbf24b50b582babfa7c5b7df42b21974ca4b3fb88ee5e34
# The Kiali server chart, and the SHA-256 of its archive from the review in vendor/README.md.
# KIALI_IMAGE pins the index digest of that review.
KIALI_VERSION=v2.34.1
KIALI_CHART_SHA256=e0219681933f85428be50fae18747778dd81ee621272473683fb3e62538f418f
KIALI_IMAGE=quay.io/kiali/kiali:v2.34.1@sha256:88d96c7b7b9bd9ceaf3b2a8097c0b0d2c5ae15f8d3a17017a5f3a163f5115d2c
# The host service on this Mac (scripts/hostsvc-serve.sh) listens on this loopback port. The pods of
# management reach it at the address that host.docker.internal has in the node container.
HOSTSVC_PORT=17443
