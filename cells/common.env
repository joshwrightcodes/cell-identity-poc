# Settings shared by every cell. These values are not secret.
# The name of the environment. The cluster_jwt plugins and the cell records carry it, and each
# attestation token has the audience spire-<POC_ENV>/<nonce>.
POC_ENV=dev
# Upstream versions.
ARGOCD_VERSION=v3.6.1
ISTIO_VERSION=1.30.8
# The External Secrets Operator chart, and the SHA-256 of its archive from the review in vendor/README.md.
EXTERNAL_SECRETS_VERSION=2.14.0
EXTERNAL_SECRETS_CHART_SHA256=0a6d9e91b1ff50adfdbf24b50b582babfa7c5b7df42b21974ca4b3fb88ee5e34
