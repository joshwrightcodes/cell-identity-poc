# Settings for the management cluster. These values are not secret.
CELL_NAME=management
CELL_MESH_TRUST_DOMAIN=management.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_BUNDLE_STORE_PORT=5050
# The trust domain of the management plane. Its SPIRE server has its own self-signed CA, with no
# upstream authority, and no secret manager holds a key for it.
SPIRE_TRUST_DOMAIN=mgmt.poc.internal
# The CA lives 90 days, so no CA rotation falls inside a run.
SPIRE_CA_TTL=2160h
# Plane workloads of this cluster, as <spiffe path>=<namespace>/<service account>. Each attests with
# a k8s_psat agent sidecar.
SPIRE_LOCAL_WORKLOADS="argocd/principal=central-view-system/argocd-agent-principal telemetry=observability-system/telemetry-gateway kiali=mesh-view-system/mesh-view-hub"
# Cells in the central Argo CD view. Each gets the agent namespace <POC_ENV>-<cell>, and a record in
# the registry of the view. It must name the clusters with the argocd-agent set in
# harness/topology.yaml, and each of them must be in SPIRE_AGENT_CELLS of dev-cp.
VIEW_CELLS="dev-cell-1 dev-cell-2"
# Cells in the mesh view of Kiali, as <cell>=<port>. The hub listens on the port for the tunnel of the
# cell, and Kiali reaches the Kubernetes API of the cell through it. It must name the clusters with
# the mesh-view set in harness/topology.yaml, and each of them must be in SPIRE_AGENT_CELLS of dev-cp.
MESH_VIEW_CELLS="dev-cell-1=18001 dev-cell-2=18002"
# The namespaces that Kiali reads in each cell. The mesh view shows the namespaces of the mesh and its
# control plane. Kiali always reads its own namespace too.
MESH_VIEW_NAMESPACES="apps-demo istio-system istio-egress"
# The environment control plane of the cells in the view. The link phase reads its node address
# and its trust bundle, so it must exist first.
VIEW_CONTROL_PLANE=dev-cp
# Lifetime of agent and workload SVIDs. The plane runs without gates, so the sidecars renew about
# every 30 minutes.
SPIRE_SVID_TTL=1h
# The namespace of the External Secrets Operator. management has no secret store: the operator
# serves only the Password generator of Grafana in this namespace.
EXTERNAL_SECRETS_NAMESPACE=observability-system
# The collector of management exports to the telemetry store, and sets its own source attributes.
COLLECTOR_STORE=lgtm.observability-system.svc.cluster.local:4317
COLLECTOR_CLUSTER=management
COLLECTOR_PLANE=management
# COLLECTOR_SENDERS names the namespaces that send OTLP to the collector on 4317 (flow N11). The
# policy admits no other namespace. COLLECTOR_JOBS names the scrape jobs that this cluster adds to
# envoy, istiod and argocd.
COLLECTOR_SENDERS="apps-demo argocd istio-egress central-view-system mesh-view-system"
COLLECTOR_JOBS="argocd-central argocd-agent-principal spire-server"
