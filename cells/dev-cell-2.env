# Settings for the dev-cell-2 cluster. These values are not secret.
CELL_NAME=dev-cell-2
CELL_MESH_TRUST_DOMAIN=dev-cell-2.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_BUNDLE_STORE_PORT=5053
# The cluster that runs the SPIRE server of the environment. The celld sidecar attests to it.
SPIRE_SERVER_CLUSTER=dev-cp
