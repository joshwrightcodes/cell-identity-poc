# Settings for the dev-cell-2 cluster. These values are not secret.
CELL_NAME=dev-cell-2
CELL_MESH_TRUST_DOMAIN=dev-cell-2.mesh.poc.internal
# Host port for the temporary port-forward to the in-cluster bundle store.
CELL_BUNDLE_STORE_PORT=5053
# The cluster that runs the SPIRE server of the environment. The celld sidecar attests to it.
SPIRE_SERVER_CLUSTER=dev-cp
# The collector of the cell sets the plane cell, the environment name and the cell name, and
# exports through the uplink to the gateway in management. COLLECTOR_SENDERS names the namespaces
# that send OTLP to the collector on 4317 (flow N11). COLLECTOR_JOBS names the scrape jobs that this
# cluster adds to envoy, istiod and argocd.
COLLECTOR_PLANE=cell
COLLECTOR_SENDERS="apps-demo argocd istio-egress cell-identity-system mesh-view-system"
COLLECTOR_JOBS="argocd-agent"
